# Neon pooled connection string. Keep this server-side only.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Public production origin used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Secret sent by Vercel when invoking protected cron routes.
CRON_SECRET=replace-with-a-long-random-value

# Server-side JustTCG credentials and the operator-controlled exchange rate.
JUSTTCG_API_KEY=replace-with-your-justtcg-key
USD_TO_VND=25000
